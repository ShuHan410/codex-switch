#!/usr/bin/env node
import fs from 'node:fs';
import readline from 'node:readline';

const args = process.argv.slice(2);
const log = process.env.CODEX_SWITCH_TEST_LOG;
const write = value => { if (log) fs.appendFileSync(log, `${JSON.stringify(value)}\n`); };

if (args[0] !== 'app-server') {
  if (args[0] === 'login' && process.env.CODEX_SWITCH_TEST_LOGIN_SUB) {
    const sub = process.env.CODEX_SWITCH_TEST_LOGIN_SUB;
    const accountId = process.env.CODEX_SWITCH_TEST_LOGIN_ACCOUNT_ID || `account-${sub}`;
    const idToken = `header.${Buffer.from(JSON.stringify({ sub, email: `${sub}@example.test` })).toString('base64url')}.signature`;
    fs.writeFileSync(`${process.env.CODEX_HOME}/auth.json`, JSON.stringify({ auth_mode: 'chatgpt', tokens: {
      refresh_token: `renewed-refresh-${sub}`, access_token: `renewed-access-${sub}`, id_token: idToken, account_id: accountId,
    } }), { mode: 0o600 });
    fs.chmodSync(`${process.env.CODEX_HOME}/auth.json`, 0o600);
  }
  write({ args, codeHome: process.env.CODEX_HOME, apiKey: process.env.OPENAI_API_KEY,
    accessToken: process.env.CODEX_ACCESS_TOKEN, authLeak: process.env.CODEX_AUTH_TOKEN });
  process.exit(Number(process.env.CODEX_SWITCH_TEST_EXIT || 0));
}

const mode = process.env.CODEX_SWITCH_TEST_RPC_MODE || 'ok';
const rpcDelay = Number(process.env.CODEX_SWITCH_TEST_RPC_DELAY || 0);
const rpcLog = process.env.CODEX_SWITCH_TEST_RPC_LOG;
const rpcWrite = value => { if (rpcLog) fs.appendFileSync(rpcLog, `${JSON.stringify(value)}\n`); };
const reply = (method, value) => {
  const event = { method, home: process.env.CODEX_HOME, pid: process.pid };
  rpcWrite({ ...event, phase: 'start' });
  setTimeout(() => { process.stdout.write(`${JSON.stringify(value)}\n`); rpcWrite({ ...event, phase: 'end' }); }, rpcDelay);
};
readline.createInterface({ input: process.stdin }).on('line', line => {
  const msg = JSON.parse(line);
  if (msg.method === 'initialize') {
    if (mode === 'timeout') return;
    if (mode === 'initialize-error') {
      process.stdout.write(`${JSON.stringify({ id: msg.id, error: { message: 'server initialization failed' } })}\n`);
      return;
    }
    if (mode === 'null-and-array') process.stdout.write('null\n[]\n');
    reply(msg.method, { id: msg.id, result: { protocolVersion: '1' } });
    return;
  }
  if (msg.method === 'account/read') {
    reply(msg.method, { id: msg.id, result: { account: { type: 'chatgpt', planType: 'test' } } });
    return;
  }
  if (msg.method === 'account/rateLimits/read') {
    let usedPercent = 25;
    if (process.env.CODEX_SWITCH_TEST_REMAINING_BY_SUB) {
      const auth = JSON.parse(fs.readFileSync(`${process.env.CODEX_HOME}/auth.json`, 'utf8'));
      const { sub } = JSON.parse(Buffer.from(auth.tokens.id_token.split('.')[1], 'base64url').toString());
      usedPercent = 100 - JSON.parse(process.env.CODEX_SWITCH_TEST_REMAINING_BY_SUB)[sub];
    }
    reply(msg.method, { id: msg.id, result: { rateLimits: { primary: { usedPercent, resetsAt: Date.now() / 1000 + 3600 } } } });
  }
});
